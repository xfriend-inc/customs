{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "1.1.0",
  "configurations": [
    {
      "name": "CLI LAMBDA",
      "type": "node-terminal",
      "command": "npm run koa:start",
      "request": "launch",
      "internalConsoleOptions": "neverOpen",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "envFile": "${workspaceFolder}/../parameterStore/quota/.qa.env"
    },
    {
      "name": "CLI TEST",
      "runtimeExecutable": "${workspaceRoot}/node_modules/.bin/jest",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--inspect-brk",
        "${workspaceRoot}/node_modules/.bin/jest",
        "--runInBand",
        "tests/unit/domain/services/check-and-update-status-service.spec.ts",
        "--coverage",
        "false"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "${workspaceFolder}/node_modules/**/*.js",
        "${workspaceFolder}/lib/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "envFile": "${workspaceFolder}/../parameterStore/puf/.test.env"
    },
    {
      "name": "CLI EXECUTE",
      "type": "node-terminal",
      "command": "node -r ts-node/register -r tsconfig-paths/register --test ./src/**/*.test.ts",
      "request": "launch",
      "internalConsoleOptions": "neverOpen",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "envFile": "${workspaceFolder}/../parameterStore/puf/.qa.env"
    },
    {
      "name": "CLI EXECUTE-LAUNCH",
      "type": "node",
      "request": "launch",
      "program": "${workspaceRoot}/src/server.js",
      "args": [],
      "cwd": "${workspaceRoot}",
      "preLaunchTask": null,
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/babel-node",
      "smartStep": false,
      "runtimeArgs": [
        "--nolazy"
      ],
      "envFile": "${workspaceFolder}/.vscode/.env.qa",
      "outputCapture": "std",
      "console": "internalConsole",
      "sourceMaps": true
    },
  ]
}
